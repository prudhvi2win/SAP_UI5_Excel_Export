<mvc:View controllerName="com.practice.northwind.controller.View2"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Page id="pageDetail"
          title="Product Details"
          showNavButton="true"
          navButtonPress=".onNavBack">

        <headerContent>
            <!-- View mode buttons -->
            <Button id="idEditBtn"
                    text="Edit"
                    icon="sap-icon://edit"
                    type="Emphasized"
                    press=".onEdit"
                    visible="{= ${viewModel>/mode} === 'view' }" />

            <Button id="idDeleteBtn"
                    text="Delete"
                    icon="sap-icon://delete"
                    type="Reject"
                    press=".onDelete"
                    visible="{= ${viewModel>/mode} === 'view' }" />

            <!-- Edit / Create mode buttons -->
            <Button id="idSaveBtn"
                    text="Save"
                    icon="sap-icon://save"
                    type="Accept"
                    press=".onSave"
                    visible="{= ${viewModel>/mode} !== 'view' }" />

            <Button id="idCancelBtn"
                    text="Cancel"
                    icon="sap-icon://cancel"
                    type="Default"
                    press=".onCancel"
                    visible="{= ${viewModel>/mode} !== 'view' }" />
        </headerContent>

        <content>
            <!-- The reusable ProductForm fragment is injected here at runtime -->
            <!-- It is loaded by the controller into the page's content aggregation -->
        </content>

    </Page>
</mvc:View>
