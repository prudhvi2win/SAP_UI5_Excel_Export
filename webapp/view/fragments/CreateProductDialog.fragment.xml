<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">

    <VBox class="sapUiMediumMargin">

        <Panel headerText="Create Product" expandable="false" id="idAddPanel">

            <content>
                <f:SimpleForm
                    editable="true"
                    layout="ResponsiveGridLayout"
                    labelSpanL="3" labelSpanM="3" emptySpanL="5" emptySpanM="1" columnsL="3" columnsM="3">

                    <f:content>

                        <Label text="Product Name" required="true" />
                        <Input
                            value="{draft>/ProductName}"
                            placeholder="e.g., Earl Grey Tea" />

                        <Label text="Select Customer" />
                        <ComboBox id="idCustomer"
                                change="onCustomerChange"
                                items="{/Customers}"
                                selectedKey="{draft>/CustomerID}">
                            <core:Item key="{CustomerID}" text="{CompanyName}" />
                        </ComboBox>

                        <Label text="Unit Price (USD)" />
                        <Input
                            value="{draft>/UnitPrice}"
                            type="Number"
                            placeholder="0.00" />

                        <Label text="Initial Stock Units" />
                        <Input
                            value="{draft>/UnitsInStock}"
                            type="Number"
                            placeholder="0" />

                        <Label text="Discontinued Status" />
                        <CheckBox
                            selected="{= ${draft>/Discontinued} === true || ${draft>/Discontinued} === 'Yes' }"
                            text="{= ${draft>/Discontinued} === true || ${draft>/Discontinued} === 'Yes' ? 'Yes' : 'No' }" />

                        <Label text="Quantity Per Unit" />
                        <Input value="{draft>/QuantityPerUnit}" />

                        <Label text="Units In Stock" />
                        <Input value="{draft>/UnitsInStock} cases" />

                        <Label text="Units On Order" />
                        <Input value="{draft>/UnitsOnOrder} cases" />
                    
                        <Label text="Reorder Level" />
                        <Input value="{draft>/ReorderLevel}" />

                    </f:content>

                </f:SimpleForm>
            </content>

        </Panel>

        <HBox
            justifyContent="End"
            class="sapUiSmallMarginTop">

            <Button
                text="Cancel"
                press="onCancel" />

            <Button
                text="Save"
                type="Emphasized"
                press="onSave"
                class="sapUiTinyMarginBegin" />

        </HBox>

    </VBox>

</core:FragmentDefinition>