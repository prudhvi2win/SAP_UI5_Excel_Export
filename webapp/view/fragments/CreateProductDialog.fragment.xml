<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog id="idCreateProductDialog" title="Register New Inventory Item">
        <content>
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
                <f:content>
                    <Label text="Product Name" required="true" />
                    <Input value="{draft>/ProductName}" placeholder="e.g., Earl Grey Tea" />

                    <Label text="Unit Price (USD)" />
                    <Input value="{draft>/UnitPrice}" type="Number" placeholder="0.00" />

                    <Label text="Initial Stock Units" />
                    <Input value="{draft>/UnitsInStock}" type="Number" placeholder="0" />
                    
                    <Label text="Discontinued Status" />
                    <CheckBox selected="{draft>/Discontinued}" text="Mark as Discontinued immediately" />
                </f:content>
            </f:SimpleForm>
        </content>
        <beginButton>
            <Button text="Save Product" type="Emphasized" press=".onSaveNewProduct" />
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCloseCreateDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>