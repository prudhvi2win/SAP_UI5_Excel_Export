<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog id="idCustF4HelpDialog" title="Select Customer" class="sapUiResponsiveContentPadding" contentWidth="65%">
        <content>
            <Table id="idCustomerResultsTable" items="{/Customers}" noDataText="No customers found.">
                <columns>
                    <Column><Text text="Customer ID" /></Column>
                    <Column><Text text="Company Name" /></Column>
                    <Column><Text text="City" /></Column>
                    <Column><Text text="Country" /></Column>
                </columns>
                <items>
                    <ColumnListItem type="Active" press=".onCustomerSelect">
                        <cells>
                            <Text text="{CustomerID}" />
                            <Text text="{CompanyName}" />
                            <Text text="{City}" />
                            <Text text="{Country}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>     
        </content>
        <endButton>
            <Button text="Close" press=".onCustomerF4Close" />  
        </endButton>
    </Dialog>
</core:FragmentDefinition>