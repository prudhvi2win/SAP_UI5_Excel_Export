<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Panel headerText="Product Details">
        <content>
            <ObjectHeader
                id="idObjectHeader"
                title="{ProductName}"
                number="{UnitPrice}"
                numberUnit="USD" icon="sap-icon://supplier" imageShape="Square">
                <attributes>
                    <ObjectAttribute text="Category: {Category/CategoryName}" />
                    <ObjectAttribute text="Supplier: {Supplier/CompanyName}" />
                </attributes>
            </ObjectHeader>

            <f:SimpleForm id="idSimpleForm" title="Warehouse Logistics" 
                        editable="true" layout="ResponsiveGridLayout" labelSpanL="3" labelSpanM="3" labelSpanS="12" adjustLabelSpan="false">
                <f:content>
                    <Title text="Stock Information" />
                    <Label text="Quantity Per Unit" />
                    <Text text="{QuantityPerUnit}" />
                    
                    <Label text="Units In Stock" />
                    <Text text="{UnitsInStock} cases" />

                    <Label text="Units On Order" />
                    <Text text="{UnitsOnOrder} cases" />
                    
                    <Label text="Reorder Level" />
                    <Text text="{ReorderLevel}" />

                    <Title text="Customer Selection" />
                    <Label text="Select Customer" />
                    <MultiComboBox id="idCustomerSelect"
                            change="onCustomerChange"
                            width="50%"
                            items="{/Customers}">
                        <core:Item key="{CustomerID}" text="{CompanyName}" />
                    </MultiComboBox>

                    <Label text="Select Customer" />
                    <Input id="idCustomerVH"
                           showValueHelp="true"
                           valueHelpRequest="onCustomerVHRequest"
                            width="50%">    
                    </Input>

                    <Label text="Customer/Orders" />
                    <RadioButtonGroup id="idCustGroup" selectedIndex="0" columns="2">
                        <buttons>
                            <RadioButton text="Orders" />
                            <RadioButton text="Customers" />
                        </buttons>
                    </RadioButtonGroup>
                </f:content>
            </f:SimpleForm>
                      
            <Table id="idOrderDetailsTable" 
                   items="{Order_Details}" 
                   headerText="Associated Customer Order Log"
                   noDataText="No orders placed for this item yet.">
                <columns>
                    <Column><Text text="Order ID" /></Column>
                    <Column><Text text="Unit Price Paid" /></Column>
                    <Column><Text text="Quantity Ordered" /></Column>
                    <Column><Text text="Applied Discount" /></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{OrderID}" />
                            <Text text="{UnitPrice} USD" />
                            <Text text="{Quantity}" />
                            <Text text="{= ${Discount} * 100 }% "/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Panel>
</core:FragmentDefinition>