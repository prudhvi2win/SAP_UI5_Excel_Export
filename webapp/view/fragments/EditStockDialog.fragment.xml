<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog id="idEditStockDialog" title="Adjust Warehouse Records">
        <content>
            <f:SimpleForm id="idEditForm" editable="true" layout="ResponsiveGridLayout">
                <f:content>
                    <Label text="Product Name" />
                    <Text text="{ProductName}" />

                    <Label text="New Units In Stock" />
                    <Input id="idNewStockInput" value="{UnitsInStock}" type="Number" />
                </f:content>
            </f:SimpleForm>
        </content>
        <beginButton>
            <Button text="Save Changes" type="Emphasized" press=".onSaveChanges" />
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCloseDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>